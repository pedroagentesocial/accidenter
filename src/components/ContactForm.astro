---
import { t } from "../i18n";
const { locale } = Astro.props as { locale: "en" | "es" };
const privacyHref = locale === "en" ? "/en/privacy-policy" : "/es/politica-de-privacidad";
const termsHref = locale === "en" ? "/en/terms-of-service" : "/es/terminos-del-servicio";
---
<div class="relative rounded-3xl overflow-hidden shadow-md border border-brand-accent/40 form-reveal" data-form-reveal>
  <img src="/images/form.jpg" alt={locale === "en" ? "Healthcare staff" : "Personal de salud"} class="w-full h-[640px] object-cover transition-transform duration-700 scale-[1.01]" loading="lazy" />
  <div class="absolute inset-0 bg-black/35"></div>
  <div class="absolute inset-0 flex">
    <div class="w-full max-w-xl p-6 sm:p-8">
      <p class="text-white/80 text-sm" data-stagger>- {locale === "en" ? "Work safe, be safe" : "Trabaje seguro, esté seguro"}</p>
      <h3 class="text-white font-heading text-3xl sm:text-4xl leading-tight" data-stagger>{locale === "en" ? "AccidentER® — Get help after an accident" : "AccidentER® — Reciba ayuda tras un accidente"}</h3>
      <p class="mt-3 text-white/90 text-sm" data-stagger>{locale === "en" ? "Bilingual team, on‑site diagnostics, and clear next steps." : "Equipo bilingüe, diagnósticos en sitio y pasos claros."}</p>
      <form class="mt-4 grid grid-cols-1 gap-3" data-contact-form data-locale={locale} data-stagger>
        <input type="text" name="name" required class="w-full rounded-md bg-white px-4 py-3 text-brand-dark placeholder-brand-dark/60 shadow transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:scale-[1.01]" placeholder={locale === "en" ? "Enter Your Name" : "Ingresa tu nombre"} />
        <input type="tel" name="phone" required class="w-full rounded-md bg-white px-4 py-3 text-brand-dark placeholder-brand-dark/60 shadow transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:scale-[1.01]" placeholder={locale === "en" ? "Enter Your Phone" : "Ingresa tu teléfono"} />
        <input type="email" name="email" required class="w-full rounded-md bg-white px-4 py-3 text-brand-dark placeholder-brand-dark/60 shadow transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:scale-[1.01]" placeholder={locale === "en" ? "Enter Your Email" : "Ingresa tu correo"} />
        <textarea name="message" rows="3" class="w-full rounded-md bg-white px-4 py-3 text-brand-dark placeholder-brand-dark/60 shadow transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:scale-[1.01]" placeholder={locale === "en" ? "Your message (optional)" : "Tu mensaje (opcional)"}></textarea>
        <label class="inline-flex items-start gap-2">
          <input type="checkbox" name="consent" class="mt-1 h-4 w-4 rounded border border-brand-accent bg-white" />
          <span class="text-xs text-white">
            {
              locale === "en" ? (
                <>
                  I confirm that I agree to share my information and accept the{" "}
                  <a href={privacyHref} class="underline hover:no-underline">Privacy Policy</a>
                  {" "}and{" "}
                  <a href={termsHref} class="underline hover:no-underline">Terms of Service</a>
                  {" "}for contact, appointment coordination, and follow-up.
                </>
              ) : (
                <>
                  Confirmo que acepto compartir mi información y estoy de acuerdo con la{" "}
                  <a href={privacyHref} class="underline hover:no-underline">Política de Privacidad</a>
                  {" "}y los{" "}
                  <a href={termsHref} class="underline hover:no-underline">Términos del Servicio</a>
                  {" "}para contacto, coordinación de citas y seguimiento.
                </>
              )
            }
          </span>
        </label>
        <button type="submit" class="button-success justify-center w-full disabled:opacity-50 disabled:cursor-not-allowed" disabled>{locale === "en" ? "Send" : "Enviar"}</button>
        <p class="hidden rounded-md px-3 py-2 text-sm font-medium" data-form-status></p>
      </form>
    </div>
    <div class="absolute right-4 sm:right-6 top-1/2 -translate-y-1/2 flex flex-col gap-3" data-stagger>
      <a href="#" class="inline-flex items-center justify-center h-9 w-9 rounded-full bg-brand-success text-white transition-transform duration-300 hover:scale-110" aria-label="Twitter">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M22.46 6c-.77.35-1.6.58-2.47.69a4.3 4.3 0 001.88-2.37 8.64 8.64 0 01-2.72 1.04 4.29 4.29 0 00-7.31 3.91A12.17 12.17 0 013 5.16a4.28 4.28 0 001.33 5.72c-.64-.02-1.24-.2-1.76-.49v.05a4.29 4.29 0 003.44 4.2c-.31.09-.64.13-.98.13-.24 0-.47-.02-.69-.06a4.29 4.29 0 004 2.97A8.61 8.61 0 012 19.54a12.15 12.15 0 006.58 1.93c7.9 0 12.22-6.54 12.22-12.22l-.01-.56A8.7 8.7 0 0024 5.5a8.5 8.5 0 01-2.54.7z"/></svg>
      </a>
      <a href="#" class="inline-flex items-center justify-center h-9 w-9 rounded-full bg-brand-success text-white transition-transform duration-300 hover:scale-110" aria-label="Facebook">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 10-11.5 9.9v-7h-2v-2.9h2v-2.2c0-2 1.2-3.1 3-3.1.9 0 1.8.16 1.8.16v2h-1c-1 0-1.3.62-1.3 1.25v1.9h2.3l-.37 2.9h-1.93v7A10 10 0 0022 12z"/></svg>
      </a>
      <a href="#" class="inline-flex items-center justify-center h-9 w-9 rounded-full bg-brand-success text-white transition-transform duration-300 hover:scale-110" aria-label="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 107.48 6a2.5 2.5 0 00-2.5-2.5zM3 8.98h4v12H3v-12zM9 8.98h3.82v1.64h.05c.53-.98 1.83-2.02 3.77-2.02 4.04 0 4.79 2.66 4.79 6.12v6.26h-4v-5.55c0-1.32-.03-3.01-1.84-3.01-1.84 0-2.12 1.44-2.12 2.92v5.64H9v-12z"/></svg>
      </a>
    </div>
  </div>
</div>
<style>
  .form-reveal {
    opacity: 0;
    transform: translateY(18px) scale(0.985);
    transition: opacity 700ms ease, transform 700ms ease;
  }
  .form-reveal.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .form-reveal [data-stagger] {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 600ms ease, transform 600ms ease;
  }
  .form-reveal.is-visible [data-stagger] {
    opacity: 1;
    transform: translateY(0);
  }
</style>
<script>
  const revealBlocks = Array.from(document.querySelectorAll("[data-form-reveal]"));
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      el.classList.add("is-visible");
      const staggerItems = Array.from(el.querySelectorAll("[data-stagger]"));
      staggerItems.forEach((item, index) => {
        (item as HTMLElement).style.transitionDelay = `${index * 90}ms`;
      });
      revealObserver.unobserve(el);
    });
  }, { threshold: 0.18 });
  revealBlocks.forEach((el) => revealObserver.observe(el));

  const webhookUrl = "https://services.leadconnectorhq.com/hooks/amDqDwinSRRhyjAJ7bWx/webhook-trigger/f8c67926-bf16-4f88-b9ba-9517035c7768";
  const forms = Array.from(document.querySelectorAll("form[data-contact-form]"));
  forms.forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    const locale = form.getAttribute("data-locale") || "en";
    const consentEl = form.querySelector('input[name="consent"]') as HTMLInputElement | null;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const statusEl = form.querySelector("[data-form-status]") as HTMLParagraphElement | null;
    const consentWarning = locale === "en"
      ? "You must accept the Privacy Policy and Terms of Service to continue."
      : "Debe aceptar la Política de Privacidad y los Términos del Servicio para continuar.";
    const sendingText = locale === "en" ? "Sending..." : "Enviando...";
    const sendText = locale === "en" ? "Send" : "Enviar";
    const successText = locale === "en"
      ? "Thank you. Your information was sent successfully."
      : "Gracias. Tu información se envió correctamente.";
    const errorText = locale === "en"
      ? "We could not send your request. Please try again."
      : "No se pudo enviar tu solicitud. Inténtalo nuevamente.";
    function setStatus(message, type) {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.remove("hidden", "bg-red-100", "text-red-700", "bg-emerald-100", "text-emerald-700");
      if (type === "error") {
        statusEl.classList.add("bg-red-100", "text-red-700");
      } else {
        statusEl.classList.add("bg-emerald-100", "text-emerald-700");
      }
    }
    function clearStatus() {
      if (!statusEl) return;
      statusEl.textContent = "";
      statusEl.classList.add("hidden");
      statusEl.classList.remove("bg-red-100", "text-red-700", "bg-emerald-100", "text-emerald-700");
    }
    function syncSubmitState() {
      if (!submitBtn || !consentEl) return;
      submitBtn.disabled = !consentEl.checked;
    }
    consentEl?.addEventListener("change", () => {
      syncSubmitState();
      clearStatus();
    });
    syncSubmitState();
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!consentEl?.checked) {
        setStatus(consentWarning, "error");
        syncSubmitState();
        return;
      }
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const payload = {
        locale,
        source: "AccidentER Homepage Form",
        name: String(data.get("name") || ""),
        phone: String(data.get("phone") || ""),
        email: String(data.get("email") || ""),
        message: String(data.get("message") || ""),
        consentAccepted: true,
        submittedAt: new Date().toISOString(),
        pageUrl: window.location.href
      };
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = sendingText;
      }
      clearStatus();
      try {
        const res = await fetch(webhookUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error("webhook_error");
        setStatus(successText, "success");
        form.reset();
      } catch {
        setStatus(errorText, "error");
      } finally {
        if (submitBtn) submitBtn.textContent = sendText;
        syncSubmitState();
      }
    });
  });
</script>
