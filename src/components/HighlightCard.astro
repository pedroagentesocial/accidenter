---
const { title, text, imageSrc = "/images/placeholder.jpg", imageAlt = title } = Astro.props as { title: string; text: string; imageSrc?: string; imageAlt?: string };
---
<div class="w-full rounded-3xl bg-white border border-brand-accent/60 overflow-hidden shadow-sm hover:shadow-md transition">
  <img src={imageSrc} alt={imageAlt} class="w-full h-36 sm:h-44 lg:h-48 object-cover" loading="lazy" />
  <div class="p-4 sm:p-5">
    <h3 class="text-base sm:text-lg font-heading text-brand-dark">{title}</h3>
    <p class="mt-2 sm:mt-3 text-sm sm:text-base text-brand-dark/90">{text}</p>
  </div>
</div>
