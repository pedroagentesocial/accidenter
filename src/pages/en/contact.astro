---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Section from "../../components/Section.astro";
import ContactForm from "../../components/ContactForm.astro";
import TestimonialsCarousel from "../../components/TestimonialsCarousel.astro";
import ContactFaqAccordion from "../../components/ContactFaqAccordion.astro";
import CTA from "../../components/CTA.astro";
import { t } from "../../i18n";
const locale = "en";
const contact = t(locale, "contact");
const seo = contact.seo;
const breadcrumb = contact.breadcrumb.items;
const hero = contact.hero;
const quickActions = contact.quickActions.items;
const faq = contact.faq;
const clinicMapEmbed = "https://www.google.com/maps?q=6770%20S%20900%20E%2C%20Midvale%2C%20UT%2084047&output=embed";
const clinicDirections = "https://www.google.com/maps/search/?api=1&query=6770%20S%20900%20E%2C%20Midvale%2C%20UT%2084047";
const extraFaq = [
  {
    question: "Do I need an appointment after an accident?",
    answer: "No. Walk-ins are welcome. You can also call ahead so our team can prepare your intake."
  },
  {
    question: "What should I bring to my visit?",
    answer: "Bring your ID, insurance information if available, and any accident reports or prior imaging."
  },
  {
    question: "Can I be seen if symptoms appear later?",
    answer: "Yes. Many accident-related symptoms appear hours or days later, and early evaluation helps recovery."
  }
];
const contactFaqItems = [...(faq.items || []), ...extraFaq].slice(0, 6);
const leadSurvey = {
  title: "Need help after an accident?",
  description: "Open the guided intake form and share your accident details with our team.",
  buttonLabel: "Open accident assistance form"
};
---
<BaseLayout locale={locale} title={seo.title} description={seo.description} canonical={seo.canonical}>
  <section class="relative overflow-hidden bg-black border-b border-brand-accent min-h-[460px] sm:min-h-[540px] lg:min-h-[620px]">
    <video id="hero-video" src="/videos/xray.mp4" class="absolute inset-0 block w-full h-full object-cover object-center transition-opacity duration-700" autoplay muted playsinline poster="/images/hero.jpg"></video>
    <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-transparent"></div>
    <div class="container relative z-10 py-16 sm:py-24 lg:py-28">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div class="">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading text-white drop-shadow-lg">{hero.title}</h1>
            <p class="mt-6 text-white drop-shadow">{hero.subtitle}</p>
            <p class="mt-2 text-sm text-white/80 drop-shadow">{hero.safetyNote}</p>
          </div>
          <div></div>
        </div>
      </div>
    </div>
    <button id="hero-sound" class="absolute bottom-4 right-4 z-10 bg-white/80 text-brand-dark px-3 py-1 rounded-full text-xs">Unmute</button>
    <script>
      const video = document.getElementById("hero-video");
      const btn = document.getElementById("hero-sound");
      if (video && btn) {
        btn.addEventListener("click", () => {
          const isMuted = video.hasAttribute("muted");
          if (isMuted) {
            video.removeAttribute("muted");
            btn.textContent = "Mute";
          } else {
            video.setAttribute("muted", "");
            btn.textContent = "Unmute";
          }
        });
      }
    </script>
  </section>
  <Breadcrumbs items={breadcrumb} />
  <Section title={""} align="center">
    <div class="max-w-6xl mx-auto rounded-3xl border border-brand-accent/40 bg-[#f7fbff] p-4 sm:p-6 lg:p-7">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        <article class="contact-quick-card-en" data-contact-quick-en>
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-dark text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.46 15.46 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.32.56 3.57.56a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.3 21 3 13.7 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.56 3.57a1 1 0 0 1-.24 1.02l-2.2 2.2Z"/></svg>
          </span>
          <h3 class="mt-3 text-xl font-heading text-brand-dark">{quickActions[0].title}</h3>
          <p class="mt-2 text-brand-dark/85">{quickActions[0].text}</p>
          <a href="tel:+18019967427" class="mt-4 button-primary w-fit">{quickActions[0].hrefLabel}</a>
        </article>
        <article class="contact-quick-card-en" data-contact-quick-en>
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-dark text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.19 7 13 7 13s7-7.81 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"/></svg>
          </span>
          <h3 class="mt-3 text-xl font-heading text-brand-dark">{quickActions[1].title}</h3>
          <p class="mt-2 text-brand-dark/85">{quickActions[1].text}</p>
          <a href="https://www.google.com/maps/search/?api=1&query=6770%20S%20900%20E%2C%20Midvale%2C%20UT%2084047" class="mt-4 button-success w-fit">{quickActions[1].hrefLabel}</a>
        </article>
        <article class="contact-quick-card-en" data-contact-quick-en>
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-dark text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M4 5h16a1 1 0 0 1 1 1v.73l-9 5.4-9-5.4V6a1 1 0 0 1 1-1Zm17 3.27V18a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8.27l8.49 5.1a1 1 0 0 0 1.02 0L21 8.27Z"/></svg>
          </span>
          <h3 class="mt-3 text-xl font-heading text-brand-dark">{quickActions[2].title}</h3>
          <p class="mt-2 text-brand-dark/85">{quickActions[2].text}</p>
          <a href="mailto:orders@accidenter.com" class="mt-4 button-outline-dark w-fit">Email team</a>
        </article>
      </div>
    </div>
    <script>
      const quickCardsEn = Array.from(document.querySelectorAll("[data-contact-quick-en]"));
      const quickObserverEn = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry, idx) => {
          if (!entry.isIntersecting) return;
          setTimeout(() => entry.target.classList.add("is-visible"), idx * 110);
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.2 });
      quickCardsEn.forEach((card) => quickObserverEn.observe(card));
    </script>
    <style>
      .contact-quick-card-en {
        border: 1px solid rgba(10, 26, 47, 0.12);
        border-radius: 1rem;
        background: #ffffff;
        padding: 1rem;
        text-align: left;
        opacity: 0;
        transform: translateY(14px) scale(.99);
        transition: opacity .55s ease, transform .55s ease, box-shadow .3s ease;
      }
      .contact-quick-card-en.is-visible {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      .contact-quick-card-en:hover {
        box-shadow: 0 16px 30px -22px rgba(10, 26, 47, 0.72);
      }
      @media (prefers-reduced-motion: reduce) {
        .contact-quick-card-en {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </Section>
  <Section title={leadSurvey.title} align="center">
    <div class="max-w-5xl mx-auto rounded-3xl border border-brand-accent/40 bg-[#f7fbff] p-4 sm:p-6 lg:p-7">
      <div class="assist-card-en" data-assist-card-en>
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-5 items-center">
          <div class="lg:col-span-3 text-left">
            <span class="inline-flex w-fit items-center rounded-full border border-brand-primary/30 bg-brand-primary/10 px-3 py-1 text-[11px] uppercase tracking-[0.16em] text-brand-primary">Guided intake</span>
            <h3 class="mt-3 text-2xl sm:text-3xl font-heading text-brand-dark">{leadSurvey.title}</h3>
            <p class="mt-3 text-brand-dark/85">{leadSurvey.description}</p>
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-2">
              <span class="inline-flex items-center gap-2 rounded-xl border border-brand-accent/40 bg-white px-3 py-2 text-sm text-brand-dark"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M4 5h16a1 1 0 0 1 1 1v.73l-9 5.4-9-5.4V6a1 1 0 0 1 1-1Zm17 3.27V18a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8.27l8.49 5.1a1 1 0 0 0 1.02 0L21 8.27Z"/></svg>Secure intake flow</span>
              <span class="inline-flex items-center gap-2 rounded-xl border border-brand-accent/40 bg-white px-3 py-2 text-sm text-brand-dark"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20Zm.75 5a.75.75 0 0 0-1.5 0v5.25c0 .27.15.52.39.65l3.25 1.88a.75.75 0 1 0 .75-1.3l-2.89-1.67V7Z"/></svg>Fast follow-up</span>
            </div>
          </div>
          <div class="lg:col-span-2 rounded-2xl border border-brand-accent/40 bg-white p-4 sm:p-5 text-center">
            <p class="text-sm text-brand-dark/80">Start your assistance request in minutes.</p>
            <button type="button" id="open-assistance-modal-en" class="mt-4 button-success inline-flex items-center justify-center w-full">
              {leadSurvey.buttonLabel}
            </button>
          </div>
        </div>
      </div>
      <div id="assistance-modal-en" class="fixed inset-0 z-[120] hidden" aria-hidden="true">
        <div id="assistance-modal-overlay-en" class="absolute inset-0 bg-black/70"></div>
        <div class="relative z-[121] min-h-screen flex items-center justify-center p-4">
          <div class="w-full max-w-5xl rounded-2xl bg-white border border-brand-accent shadow-xl overflow-hidden">
            <div class="flex items-center justify-between px-4 py-3 border-b border-brand-accent">
              <h3 class="font-heading text-brand-dark">{leadSurvey.buttonLabel}</h3>
              <button type="button" id="close-assistance-modal-en" class="button-outline-dark">×</button>
            </div>
            <div class="p-0">
              <iframe
                src="https://api.leadconnectorhq.com/widget/survey/VPSfhjdEmD58v7jc5ocl"
                style="border:none;width:100%;"
                scrolling="no"
                id="VPSfhjdEmD58v7jc5ocl"
                title="survey"
                class="w-full min-h-[620px]"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script>
      const assistCardEn = document.querySelector("[data-assist-card-en]");
      const assistObserverEn = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.2 });
      if (assistCardEn) assistObserverEn.observe(assistCardEn);
    </script>
    <style>
      .assist-card-en {
        border: 1px solid rgba(10, 26, 47, 0.12);
        border-radius: 1rem;
        background: #ffffff;
        padding: 1rem;
        opacity: 0;
        transform: translateY(14px) scale(.99);
        transition: opacity .55s ease, transform .55s ease, box-shadow .3s ease;
      }
      .assist-card-en.is-visible {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      .assist-card-en:hover {
        box-shadow: 0 18px 30px -24px rgba(10, 26, 47, 0.75);
      }
      @media (prefers-reduced-motion: reduce) {
        .assist-card-en {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
    <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
    <script>
      const assistanceModalEn = document.getElementById("assistance-modal-en");
      const openAssistanceModalEn = document.getElementById("open-assistance-modal-en");
      const closeAssistanceModalEn = document.getElementById("close-assistance-modal-en");
      const assistanceModalOverlayEn = document.getElementById("assistance-modal-overlay-en");
      function showAssistanceModalEn() {
        if (!assistanceModalEn) return;
        assistanceModalEn.classList.remove("hidden");
        assistanceModalEn.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }
      function hideAssistanceModalEn() {
        if (!assistanceModalEn) return;
        assistanceModalEn.classList.add("hidden");
        assistanceModalEn.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }
      openAssistanceModalEn?.addEventListener("click", showAssistanceModalEn);
      closeAssistanceModalEn?.addEventListener("click", hideAssistanceModalEn);
      assistanceModalOverlayEn?.addEventListener("click", hideAssistanceModalEn);
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") hideAssistanceModalEn();
      });
    </script>
  </Section>
  <section class="container py-8">
    <ContactForm locale={locale} />
  </section>
  <Section title={"What our patients say"} align="center">
    <TestimonialsCarousel locale={locale} />
  </Section>
  <Section title={"Common questions before your visit"} align="center">
    <ContactFaqAccordion items={contactFaqItems} locale={locale} />
  </Section>
  <section class="container py-8 sm:py-12">
    <div class="max-w-6xl mx-auto">
      <div class="rounded-3xl border border-brand-accent/40 bg-[#f4f8ff] p-4 sm:p-6 lg:p-8 shadow-[0_18px_45px_-30px_rgba(10,26,47,0.45)]">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 sm:gap-6 items-stretch">
          <div class="lg:col-span-3 overflow-hidden rounded-2xl border border-brand-accent/30 min-h-[280px]">
            <iframe src={clinicMapEmbed} class="h-full w-full min-h-[280px]" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="AccidentER clinic map"></iframe>
          </div>
          <div class="lg:col-span-2 rounded-2xl border border-brand-dark/10 bg-brand-dark p-4 sm:p-5 text-white flex flex-col justify-start">
            <span class="inline-flex w-fit items-center rounded-full border border-brand-success/35 bg-brand-success/15 px-3 py-1 text-[11px] uppercase tracking-[0.16em] text-brand-success">Walk-in care</span>
            <p class="mt-3 text-sm sm:text-base text-white/90">Fast accident-focused care with bilingual support and on-site diagnostics.</p>
            <ul class="mt-3.5 space-y-2 text-sm text-white/80">
              <li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-brand-success/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.19 7 13 7 13s7-7.81 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"/></svg><span>6770 S 900 E, Midvale, UT 84047</span></li>
              <li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-brand-success/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.75a.75.75 0 0 1 .75.75v8.25h4.75a.75.75 0 0 1 0 1.5H12a.75.75 0 0 1-.75-.75V2.5a.75.75 0 0 1 .75-.75ZM12 4a8 8 0 1 0 8 8 .75.75 0 0 1 1.5 0 9.5 9.5 0 1 1-9.5-9.5.75.75 0 0 1 0 1.5Z"/></svg><span>Mon–Fri · 9:00 AM–7:00 PM</span></li>
              <li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-brand-success/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.75a.75.75 0 0 1 .75.75v8.25h4.75a.75.75 0 0 1 0 1.5H12a.75.75 0 0 1-.75-.75V2.5a.75.75 0 0 1 .75-.75ZM12 4a8 8 0 1 0 8 8 .75.75 0 0 1 1.5 0 9.5 9.5 0 1 1-9.5-9.5.75.75 0 0 1 0 1.5Z"/></svg><span>Sat · 9:00 AM–3:00 PM</span></li>
            </ul>
            <div class="mt-4 flex flex-col items-center gap-2.5">
              <div class="w-fit scale-90 sm:scale-95 origin-center"><CTA text={"Call Now"} href={"tel:+18019967427"} variant="primary" /></div>
              <div class="w-fit scale-90 sm:scale-95 origin-center"><CTA text={"Open in Maps"} href={clinicDirections} variant="success" /></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
