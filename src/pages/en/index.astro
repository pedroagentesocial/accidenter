---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import CTA from "../../components/CTA.astro";
import ContactForm from "../../components/ContactForm.astro";
import TestimonialsCarousel from "../../components/TestimonialsCarousel.astro";
import HeroSection from "../../components/react/HeroSection";
import ModernIntroSection from "../../components/react/ModernIntroSection";
import AfterAccidentSection from "../../components/react/AfterAccidentSection";
import WhyChooseSection from "../../components/react/WhyChooseSection";
import services from "../../data/services";
import { t } from "../../i18n";
const locale = "en";
const seo = t(locale, "home.seo");
const hero = t(locale, "home.hero");
const afterAccident = t(locale, "home.afterAccident");
const whyAccidentER = t(locale, "home.whyAccidentER");
const closingCTA = t(locale, "home.closingCTA");
const whyImages = [
  "/images/expertise.jpg",
  "/images/diagnostics.jpg",
  "/images/comunication.jpg",
  "/images/efficient.jpg"
];
const importantOrder = [
  "accident-medical-evaluation",
  "concussion-tbi-evaluation",
  "whiplash-neck-injury-evaluation",
  "back-spine-injury-evaluation",
  "soft-tissue-injury-evaluation",
  "work-injury-evaluation"
];
const importantServices = importantOrder
  .map((slug) => services.find((s) => s.slug === slug))
  .filter(Boolean);
const clinicMapEmbed = "https://www.google.com/maps?q=6770%20S%20900%20E%2C%20Midvale%2C%20UT%2084047&output=embed";
const clinicDirections = "https://www.google.com/maps/search/?api=1&query=6770%20S%20900%20E%2C%20Midvale%2C%20UT%2084047";
---
<BaseLayout locale={locale} title={seo.title} description={seo.description} canonical={seo.canonical}>
  <HeroSection
    client:load
    locale={locale}
    title={hero.title}
    subtitle={hero.subtitle}
    safetyNote={hero.safetyNote}
    primaryCTA={hero.primaryCTA}
    secondaryCTA={hero.secondaryCTA}
  />
  <ModernIntroSection
    client:load
    locale={locale}
    title="Let us help you AccidentER®"
    description="Our goal is to deliver high-quality care and get you safely in and out as quickly as possible."
    ctaText="View All Services"
    ctaHref="/en/services"
  />
  <AfterAccidentSection client:load locale={locale} title={afterAccident.title} steps={afterAccident.steps} />
  <WhyChooseSection client:load locale={locale} title={whyAccidentER.title} points={whyAccidentER.points} images={whyImages} />
  <section class="container py-6 sm:py-8">
    <ContactForm locale={locale} />
  </section>
  <Section title={"Real stories from AccidentER® patients"} align="center">
    <TestimonialsCarousel locale={locale} />
    <div class="mt-5 sm:mt-6 max-w-4xl mx-auto rounded-2xl p-4 sm:p-6 shadow-sm">
      <div class="flex justify-center">
        <button type="button" id="open-review-modal-en" class="button-success inline-flex items-center justify-center">
          Write your opinion
        </button>
      </div>
      <div id="review-modal-en" class="fixed inset-0 z-[120] hidden" aria-hidden="true">
        <div id="review-modal-overlay-en" class="absolute inset-0 bg-black/70"></div>
        <div class="relative z-[121] min-h-screen flex items-center justify-center p-4">
          <div class="w-full max-w-5xl rounded-2xl bg-white border border-brand-accent shadow-xl overflow-hidden">
            <div class="flex items-center justify-between px-4 py-3 border-b border-brand-accent">
              <h3 class="font-heading text-brand-dark">Write your opinion</h3>
              <button type="button" id="close-review-modal-en" class="button-outline-dark">×</button>
            </div>
            <div class="p-0">
              <iframe
                src="https://api.leadconnectorhq.com/widget/form/api0Lg5MZ8ZSi5fOyHmj"
                style="width:100%;height:100%;border:none;border-radius:3px"
                id="inline-api0Lg5MZ8ZSi5fOyHmj-en"
                data-layout="{'id':'INLINE'}"
                data-trigger-type="alwaysShow"
                data-trigger-value=""
                data-activation-type="alwaysActivated"
                data-activation-value=""
                data-deactivation-type="neverDeactivate"
                data-deactivation-value=""
                data-form-name="Internal Review Form"
                data-height="604"
                data-layout-iframe-id="inline-api0Lg5MZ8ZSi5fOyHmj-en"
                data-form-id="api0Lg5MZ8ZSi5fOyHmj"
                title="Internal Review Form"
                class="w-full min-h-[604px]"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
      <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
      <script>
        const reviewModalEn = document.getElementById("review-modal-en");
        const openReviewModalEn = document.getElementById("open-review-modal-en");
        const closeReviewModalEn = document.getElementById("close-review-modal-en");
        const reviewModalOverlayEn = document.getElementById("review-modal-overlay-en");
        function showReviewModalEn() {
          if (!reviewModalEn) return;
          reviewModalEn.classList.remove("hidden");
          reviewModalEn.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        }
        function hideReviewModalEn() {
          if (!reviewModalEn) return;
          reviewModalEn.classList.add("hidden");
          reviewModalEn.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }
        openReviewModalEn?.addEventListener("click", showReviewModalEn);
        closeReviewModalEn?.addEventListener("click", hideReviewModalEn);
        reviewModalOverlayEn?.addEventListener("click", hideReviewModalEn);
        window.addEventListener("keydown", (event) => {
          if (event.key === "Escape") hideReviewModalEn();
        });
      </script>
    </div>
  </Section>
  <section class="container py-8 sm:py-12">
    <div class="max-w-6xl mx-auto">
      <div class="rounded-3xl border border-brand-accent/40 bg-[#f4f8ff] p-4 sm:p-6 lg:p-8 shadow-[0_18px_45px_-30px_rgba(10,26,47,0.45)]">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 sm:gap-6 items-stretch">
          <div class="lg:col-span-3 overflow-hidden rounded-2xl border border-brand-accent/30 min-h-[280px]">
            <iframe
              src={clinicMapEmbed}
              class="h-full w-full min-h-[280px]"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="AccidentER clinic map"
            ></iframe>
          </div>
          <div class="lg:col-span-2 rounded-2xl border border-brand-dark/10 bg-brand-dark p-4 sm:p-5 text-white flex flex-col justify-start">
            <span class="inline-flex w-fit items-center rounded-full border border-brand-success/35 bg-brand-success/15 px-3 py-1 text-[11px] uppercase tracking-[0.16em] text-brand-success">Walk-in care</span>
            <p class="mt-3 text-sm sm:text-base text-white/90">Fast accident-focused care with bilingual support and on-site diagnostics.</p>
            <ul class="mt-3.5 space-y-2 text-sm text-white/80">
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-brand-success/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.19 7 13 7 13s7-7.81 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"/></svg>
                <span>6770 S 900 E, Midvale, UT 84047</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-brand-success/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.75a.75.75 0 0 1 .75.75v8.25h4.75a.75.75 0 0 1 0 1.5H12a.75.75 0 0 1-.75-.75V2.5a.75.75 0 0 1 .75-.75ZM12 4a8 8 0 1 0 8 8 .75.75 0 0 1 1.5 0 9.5 9.5 0 1 1-9.5-9.5.75.75 0 0 1 0 1.5Z"/></svg>
                <span>Mon–Fri · 9:00 AM–7:00 PM</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-brand-success/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.75a.75.75 0 0 1 .75.75v8.25h4.75a.75.75 0 0 1 0 1.5H12a.75.75 0 0 1-.75-.75V2.5a.75.75 0 0 1 .75-.75ZM12 4a8 8 0 1 0 8 8 .75.75 0 0 1 1.5 0 9.5 9.5 0 1 1-9.5-9.5.75.75 0 0 1 0 1.5Z"/></svg>
                <span>Sat · 9:00 AM–3:00 PM</span>
              </li>
            </ul>
            <div class="mt-4 flex flex-col items-center gap-2.5">
              <div class="w-fit scale-90 sm:scale-95 origin-center"><CTA text={"Call Now"} href={"tel:+18019967427"} variant="primary" /></div>
              <div class="w-fit scale-90 sm:scale-95 origin-center"><CTA text={"Open in Maps"} href={clinicDirections} variant="success" /></div>
            </div>
            <div class="mt-4 border-t border-white/15 pt-3">
              <div class="flex items-center justify-center gap-2.5">
                <a href="https://www.instagram.com/explore/search/keyword/?q=AccidentER%20Urgent%20Care%20MD" target="_blank" rel="noopener noreferrer" class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white transition-transform duration-300 hover:scale-110" aria-label="Instagram">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5a4.25 4.25 0 0 0 4.25-4.25v-8.5a4.25 4.25 0 0 0-4.25-4.25h-8.5Zm8.88 2.12a1.12 1.12 0 1 1 0 2.25 1.12 1.12 0 0 1 0-2.25ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z"/></svg>
                </a>
                <a href="https://www.facebook.com/search/top?q=AccidentER%20Urgent%20Care%20MD" target="_blank" rel="noopener noreferrer" class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white transition-transform duration-300 hover:scale-110" aria-label="Facebook">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.87.25-1.46 1.5-1.46h1.6V4.94A21.4 21.4 0 0 0 14.2 4c-2.37 0-3.99 1.45-3.99 4.1V11H7.5v3h2.71v8h3.29Z"/></svg>
                </a>
                <a href="https://www.tiktok.com/search?q=AccidentER%20Urgent%20Care%20MD" target="_blank" rel="noopener noreferrer" class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white transition-transform duration-300 hover:scale-110" aria-label="TikTok">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M14.76 3c.58 1.38 1.72 2.56 3.24 3.14v2.52a7.1 7.1 0 0 1-3.2-.86v5.28a5.94 5.94 0 1 1-5.1-5.88v2.6a3.36 3.36 0 1 0 2.52 3.24V3h2.54Z"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
