---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Section from "../../../components/Section.astro";
import CTA from "../../../components/CTA.astro";
import TestimonialsCarousel from "../../../components/TestimonialsCarousel.astro";
import ContactForm from "../../../components/ContactForm.astro";
import { t } from "../../../i18n";
import services from "../../../data/services";
const locale = "en";
const seo = t(locale, "servicesIndex.seo");
const breadcrumb = [
  { label: t(locale, "common.breadcrumb.home"), href: "/en" },
  { label: t(locale, "common.breadcrumb.services"), href: "/en/services" }
];
const hero = t(locale, "servicesIndex.hero");
const intro = t(locale, "servicesIndex.intro");
const closingCTA = t(locale, "home.closingCTA");
const clinicMapEmbed = "https://www.google.com/maps?q=6770%20S%20900%20E%2C%20Midvale%2C%20UT%2084047&output=embed";
const clinicDirections = "https://www.google.com/maps/search/?api=1&query=6770%20S%20900%20E%2C%20Midvale%2C%20UT%2084047";
const ordered = services;
const serviceModalItems = ordered.map((s) => {
  const detail: any = t(locale, `servicePage.entries.${s.slug}`) || {};
  const highlights = Array.isArray(detail?.highlights)
    ? detail.highlights.slice(0, 3).map((h: any) => h?.title || h?.text).filter(Boolean)
    : [];
  return {
    slug: s.slug,
    name: t(locale, `${s.i18nKey}.name`),
    shortDescription: t(locale, `${s.i18nKey}.shortDescription`),
    subtitle: detail?.hero?.subtitle || "",
    overview: detail?.overview?.text || "",
    highlights
  };
});
const imagesBySlug: Record<string, string> = {
  "accident-medical-evaluation": "accident-medical.jpg",
  "concussion-tbi-evaluation": "tbi.jpg",
  "whiplash-neck-injury-evaluation": "neck.jpg",
  "back-spine-injury-evaluation": "back.jpg",
  "soft-tissue-injury-evaluation": "soft.jpg",
  "work-injury-evaluation": "work.jpg",
  "diagnostic-evaluation": "diagnostic.jpg",
  "motor-vehicle-post-accident-care": "postaccident.jpg",
  "care-plan-coordination": "support.jpg"
};
---
<BaseLayout locale={locale} title={seo.title} description={seo.description} canonical={seo.canonical}>
  <section class="relative overflow-hidden bg-black border-b border-brand-accent min-h-[460px] sm:min-h-[560px] lg:min-h-[640px]">
    <video id="hero-video" src="/videos/postaccident.mp4" class="absolute inset-0 block w-full h-full object-cover object-center transition-opacity duration-700" autoplay muted playsinline poster="/images/postaccident.jpg"></video>
    <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-transparent"></div>
    <div class="container relative z-10 py-16 sm:py-24 lg:py-28">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-end">
          <div>
            <span class="inline-flex items-center rounded-full border border-white/25 bg-white/10 px-3 py-1 text-xs uppercase tracking-[0.14em] text-white/90">Services</span>
            <h1 class="mt-4 text-4xl sm:text-5xl lg:text-6xl font-heading text-white drop-shadow-lg">{hero.title}</h1>
            <p class="mt-6 text-white/95 drop-shadow max-w-2xl">{hero.subtitle}</p>
            <div class="mt-8 sm:mt-10 flex flex-wrap gap-3 sm:gap-4">
              <CTA text={"Call"} href={"tel:+18019967427"} variant="primary" />
              <CTA text={"View All Services"} href={"/en/services"} variant="success" />
            </div>
            <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3">
              <div class="rounded-xl border border-white/20 bg-white/10 p-3">
                <p class="text-xs uppercase tracking-[0.14em] text-white/75">Walk-ins</p>
                <p class="text-white font-heading">Same-day care</p>
              </div>
              <div class="rounded-xl border border-white/20 bg-white/10 p-3">
                <p class="text-xs uppercase tracking-[0.14em] text-white/75">Diagnostics</p>
                <p class="text-white font-heading">On-site imaging</p>
              </div>
              <div class="rounded-xl border border-white/20 bg-white/10 p-3">
                <p class="text-xs uppercase tracking-[0.14em] text-white/75">Support</p>
                <p class="text-white font-heading">Bilingual team</p>
              </div>
            </div>
          </div>
          <div></div>
        </div>
      </div>
    </div>
    <button id="hero-sound" class="absolute bottom-4 right-4 z-10 bg-white/80 text-brand-dark px-3 py-1 rounded-full text-xs">Unmute</button>
    <script>
      const video = /** @type {HTMLVideoElement|null} */ (document.getElementById("hero-video"));
      const btn = document.getElementById("hero-sound");
      if (video && btn) {
        btn.addEventListener("click", () => {
          const isMuted = video.hasAttribute("muted");
          if (isMuted) {
            video.removeAttribute("muted");
            btn.textContent = "Mute";
          } else {
            video.setAttribute("muted", "");
            btn.textContent = "Unmute";
          }
        });
      }
    </script>
  </section>
  <Breadcrumbs items={breadcrumb} />
  <Section title={"How our service flow works"} align="center">
    <div class="max-w-5xl mx-auto rounded-3xl border border-brand-accent/40 bg-white p-5 sm:p-6 lg:p-7 shadow-sm">
      <div class="space-y-4 sm:space-y-5">
        <article class="flow-list-card group" data-flow-item-en>
          <div class="flex items-start gap-3 sm:gap-4">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-brand-dark text-white font-heading text-base">1</span>
            <div class="flex-1">
              <p class="text-xs uppercase tracking-[0.12em] text-brand-dark/60">Start here</p>
              <h3 class="mt-1 text-xl sm:text-2xl font-heading text-brand-dark">Browse & choose a service</h3>
              <p class="mt-2 text-brand-dark/85">Explore accident care services and select what fits your symptoms and recovery stage.</p>
            </div>
            <img src="/images/browse.jpg" alt="Browse & choose a service" class="hidden sm:block h-20 w-28 rounded-xl object-cover border border-brand-accent/40" />
          </div>
        </article>
        <article class="flow-list-card group" data-flow-item-en>
          <div class="flex items-start gap-3 sm:gap-4">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-brand-dark text-white font-heading text-base">2</span>
            <div class="flex-1">
              <p class="text-xs uppercase tracking-[0.12em] text-brand-dark/60">Scheduling</p>
              <h3 class="mt-1 text-xl sm:text-2xl font-heading text-brand-dark">Book a visit</h3>
              <p class="mt-2 text-brand-dark/85">Schedule online or walk in. We prioritize quick intake and practical next steps.</p>
            </div>
            <img src="/images/appointmen.jpg" alt="Book an appointment" class="hidden sm:block h-20 w-28 rounded-xl object-cover border border-brand-accent/40" />
          </div>
        </article>
        <article class="flow-list-card group" data-flow-item-en>
          <div class="flex items-start gap-3 sm:gap-4">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-brand-dark text-white font-heading text-base">3</span>
            <div class="flex-1">
              <p class="text-xs uppercase tracking-[0.12em] text-brand-dark/60">Clinical evaluation</p>
              <h3 class="mt-1 text-xl sm:text-2xl font-heading text-brand-dark">Meet your clinician</h3>
              <p class="mt-2 text-brand-dark/85">Get focused evaluation, diagnostics when needed, and a clear treatment plan.</p>
            </div>
            <img src="/images/consult.jpg" alt="Consult with a clinician" class="hidden sm:block h-20 w-28 rounded-xl object-cover border border-brand-accent/40" />
          </div>
        </article>
        <article class="flow-list-card group" data-flow-item-en>
          <div class="flex items-start gap-3 sm:gap-4">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-brand-dark text-white font-heading text-base">4</span>
            <div class="flex-1">
              <p class="text-xs uppercase tracking-[0.12em] text-brand-dark/60">Recovery</p>
              <h3 class="mt-1 text-xl sm:text-2xl font-heading text-brand-dark">Recovery support</h3>
              <p class="mt-2 text-brand-dark/85">Follow-up guidance, coordinated care, and support to keep your recovery on track.</p>
            </div>
            <img src="/images/support.jpg" alt="Get treatment and support" class="hidden sm:block h-20 w-28 rounded-xl object-cover border border-brand-accent/40" />
          </div>
        </article>
      </div>
    </div>
    <style>
      .flow-list-card {
        border: 1px solid rgba(10, 26, 47, 0.12);
        border-radius: 1rem;
        padding: 1rem;
        background: #ffffff;
        opacity: 0;
        transform: translateY(18px) scale(.985);
        transition: opacity .55s ease, transform .55s ease, box-shadow .3s ease;
      }
      .flow-list-card.is-visible {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      .flow-list-card:hover {
        box-shadow: 0 16px 28px -22px rgba(10, 26, 47, 0.7);
      }
      @media (prefers-reduced-motion: reduce) {
        .flow-list-card {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
    <script>
      const flowCardsEn = Array.from(document.querySelectorAll("[data-flow-item-en]"));
      const flowObserverEn = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry, idx) => {
          if (!entry.isIntersecting) return;
          const element = entry.target;
          setTimeout(() => element.classList.add("is-visible"), idx * 120);
          observer.unobserve(element);
        });
      }, { threshold: 0.2 });
      flowCardsEn.forEach((card) => flowObserverEn.observe(card));
    </script>
  </Section>
  <Section title={intro.title} align="center">
    <p class="max-w-3xl mx-auto text-brand-dark/80 mb-6">{intro.text}</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {ordered.map((s) => (
        <button
          type="button"
          class="text-left group rounded-2xl border border-brand-accent/40 bg-white overflow-hidden transition-all duration-300 hover:shadow-lg hover:-translate-y-1"
          data-service-modal-open={s.slug}
        >
          <img src={`/images/${imagesBySlug[s.slug]}`} alt={t(locale, `${s.i18nKey}.name`)} class="w-full h-44 sm:h-48 object-cover" />
          <div class="p-4">
            <p class="text-xs uppercase tracking-[0.14em] text-brand-dark/60">Tap to preview</p>
            <h3 class="mt-1.5 text-xl font-heading text-brand-dark">{t(locale, `${s.i18nKey}.name`)}</h3>
            <p class="mt-2 text-brand-dark/80">{t(locale, `${s.i18nKey}.shortDescription`)}</p>
          </div>
        </button>
      ))}
    </div>
    <script type="application/json" id="service-modal-data-en" set:html={JSON.stringify(serviceModalItems)} />
    <div id="service-modal-en" class="fixed inset-0 z-[130] hidden" aria-hidden="true">
      <div class="absolute inset-0 bg-black/70" data-service-modal-overlay-en></div>
      <div class="relative z-[131] min-h-screen flex items-center justify-center p-4">
        <div class="w-full max-w-3xl rounded-3xl bg-white border border-brand-accent/40 shadow-xl overflow-hidden">
          <div class="p-5 sm:p-6 border-b border-brand-accent/30 flex items-start justify-between gap-4">
            <div>
              <p class="text-xs uppercase tracking-[0.14em] text-brand-dark/60">Service overview</p>
              <h3 id="service-modal-title-en" class="mt-1 text-2xl font-heading text-brand-dark"></h3>
            </div>
            <button type="button" class="button-outline-dark" data-service-modal-close-en>×</button>
          </div>
          <div class="p-5 sm:p-6">
            <p id="service-modal-subtitle-en" class="text-brand-dark/85"></p>
            <p id="service-modal-overview-en" class="mt-3 text-brand-dark/80"></p>
            <div class="mt-5">
              <p class="text-sm uppercase tracking-[0.12em] text-brand-dark/60">Highlights</p>
              <ul id="service-modal-highlights-en" class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2"></ul>
            </div>
            <div class="mt-6 flex flex-wrap gap-3">
              <CTA text={"Call now"} href={"tel:+18019967427"} variant="primary" />
              <CTA text={"Schedule now"} href={"mailto:orders@accidenter.com"} variant="success" />
            </div>
          </div>
        </div>
      </div>
    </div>
    <script>
      const dataElEn = document.getElementById("service-modal-data-en");
      const modalEn = document.getElementById("service-modal-en");
      const overlayEn = document.querySelector("[data-service-modal-overlay-en]");
      const closeBtnEn = document.querySelector("[data-service-modal-close-en]");
      const openBtnsEn = Array.from(document.querySelectorAll("[data-service-modal-open]"));
      const titleElEn = document.getElementById("service-modal-title-en");
      const subtitleElEn = document.getElementById("service-modal-subtitle-en");
      const overviewElEn = document.getElementById("service-modal-overview-en");
      const highlightsElEn = document.getElementById("service-modal-highlights-en");
      const modalDataEn = dataElEn ? JSON.parse(dataElEn.textContent || "[]") : [];

      const showModalEn = (slug) => {
        const item = modalDataEn.find((entry) => entry.slug === slug);
        if (!item || !modalEn || !titleElEn || !subtitleElEn || !overviewElEn || !highlightsElEn) return;
        titleElEn.textContent = item.name || "";
        subtitleElEn.textContent = item.subtitle || item.shortDescription || "";
        overviewElEn.textContent = item.overview || item.shortDescription || "";
        highlightsElEn.innerHTML = "";
        const points = (item.highlights && item.highlights.length ? item.highlights : [item.shortDescription]).slice(0, 4);
        points.forEach((point) => {
          const li = document.createElement("li");
          li.className = "rounded-xl border border-brand-accent/40 bg-[#f7fbff] px-3 py-2 text-sm text-brand-dark";
          li.textContent = point;
          highlightsElEn.appendChild(li);
        });
        modalEn.classList.remove("hidden");
        modalEn.setAttribute("aria-hidden", "false");
      };

      const hideModalEn = () => {
        if (!modalEn) return;
        modalEn.classList.add("hidden");
        modalEn.setAttribute("aria-hidden", "true");
      };

      openBtnsEn.forEach((btn) => {
        btn.addEventListener("click", () => showModalEn(btn.getAttribute("data-service-modal-open")));
      });
      closeBtnEn?.addEventListener("click", hideModalEn);
      overlayEn?.addEventListener("click", hideModalEn);
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") hideModalEn();
      });
    </script>
  </Section>
  <Section title={"Built for speed, clarity, and recovery"} align="center">
    <div class="max-w-6xl mx-auto rounded-3xl border border-brand-accent/40 bg-[#f7fbff] p-5 sm:p-6 lg:p-7">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
        <div class="rounded-2xl border border-brand-accent/40 bg-white p-5 text-left shadow-sm">
          <p class="text-xs uppercase tracking-[0.14em] text-brand-dark/60">Fast intake</p>
          <h3 class="mt-1.5 text-xl font-heading text-brand-dark">Immediate accident-focused evaluation</h3>
          <p class="mt-2 text-brand-dark/80">Our team prioritizes quick triage and focused assessment so you can start treatment without delays.</p>
        </div>
        <div class="rounded-2xl border border-brand-accent/40 bg-white p-5 text-left shadow-sm">
          <p class="text-xs uppercase tracking-[0.14em] text-brand-dark/60">On-site diagnostics</p>
          <h3 class="mt-1.5 text-xl font-heading text-brand-dark">Clinical decisions with real data</h3>
          <p class="mt-2 text-brand-dark/80">X-ray and diagnostics are available in clinic when indicated, helping us move from symptoms to plan quickly.</p>
        </div>
        <div class="rounded-2xl border border-brand-accent/40 bg-white p-5 text-left shadow-sm">
          <p class="text-xs uppercase tracking-[0.14em] text-brand-dark/60">Bilingual communication</p>
          <h3 class="mt-1.5 text-xl font-heading text-brand-dark">English and Spanish support</h3>
          <p class="mt-2 text-brand-dark/80">Clear explanations, better understanding, and confident next steps in the language you prefer.</p>
        </div>
        <div class="rounded-2xl border border-brand-accent/40 bg-white p-5 text-left shadow-sm">
          <p class="text-xs uppercase tracking-[0.14em] text-brand-dark/60">Recovery guidance</p>
          <h3 class="mt-1.5 text-xl font-heading text-brand-dark">Structured follow-up and support</h3>
          <p class="mt-2 text-brand-dark/80">You leave with a practical care plan and coordinated follow-up to keep your recovery on track.</p>
        </div>
      </div>
      <div class="mt-6 flex justify-center">
        <CTA text="View All Services" href="/en/services" variant="primary" />
      </div>
    </div>
  </Section>
  <Section title={"What Our Patients Say"}>
    <div class="max-w-6xl mx-auto">
      <TestimonialsCarousel locale={locale} />
    </div>
  </Section>
  <section class="container py-8">
    <ContactForm locale={locale} />
  </section>
  <section class="container py-8 sm:py-12">
    <div class="max-w-6xl mx-auto">
      <div class="rounded-3xl border border-brand-accent/40 bg-[#f4f8ff] p-4 sm:p-6 lg:p-8 shadow-[0_18px_45px_-30px_rgba(10,26,47,0.45)]">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 sm:gap-6 items-stretch">
          <div class="lg:col-span-3 overflow-hidden rounded-2xl border border-brand-accent/30 min-h-[280px]">
            <iframe
              src={clinicMapEmbed}
              class="h-full w-full min-h-[280px]"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="AccidentER clinic map"
            ></iframe>
          </div>
          <div class="lg:col-span-2 rounded-2xl border border-brand-dark/10 bg-brand-dark p-4 sm:p-5 text-white flex flex-col justify-start">
            <span class="inline-flex w-fit items-center rounded-full border border-brand-success/35 bg-brand-success/15 px-3 py-1 text-[11px] uppercase tracking-[0.16em] text-brand-success">Walk-in care</span>
            <p class="mt-3 text-sm sm:text-base text-white/90">Fast accident-focused care with bilingual support and on-site diagnostics.</p>
            <ul class="mt-3.5 space-y-2 text-sm text-white/80">
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-brand-success/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.19 7 13 7 13s7-7.81 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"/></svg>
                <span>6770 S 900 E, Midvale, UT 84047</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-brand-success/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.75a.75.75 0 0 1 .75.75v8.25h4.75a.75.75 0 0 1 0 1.5H12a.75.75 0 0 1-.75-.75V2.5a.75.75 0 0 1 .75-.75ZM12 4a8 8 0 1 0 8 8 .75.75 0 0 1 1.5 0 9.5 9.5 0 1 1-9.5-9.5.75.75 0 0 1 0 1.5Z"/></svg>
                <span>Mon–Fri · 9:00 AM–7:00 PM</span>
              </li>
              <li class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-brand-success/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.75a.75.75 0 0 1 .75.75v8.25h4.75a.75.75 0 0 1 0 1.5H12a.75.75 0 0 1-.75-.75V2.5a.75.75 0 0 1 .75-.75ZM12 4a8 8 0 1 0 8 8 .75.75 0 0 1 1.5 0 9.5 9.5 0 1 1-9.5-9.5.75.75 0 0 1 0 1.5Z"/></svg>
                <span>Sat · 9:00 AM–3:00 PM</span>
              </li>
            </ul>
            <div class="mt-4 flex flex-col items-center gap-2.5">
              <div class="w-fit scale-90 sm:scale-95 origin-center"><CTA text={"Call Now"} href={"tel:+18019967427"} variant="primary" /></div>
              <div class="w-fit scale-90 sm:scale-95 origin-center"><CTA text={"Open in Maps"} href={clinicDirections} variant="success" /></div>
            </div>
            <div class="mt-4 border-t border-white/15 pt-3">
              <div class="flex items-center justify-center gap-2.5">
                <a href="https://www.instagram.com/explore/search/keyword/?q=AccidentER%20Urgent%20Care%20MD" target="_blank" rel="noopener noreferrer" class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white transition-transform duration-300 hover:scale-110" aria-label="Instagram">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2Zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5a4.25 4.25 0 0 0 4.25-4.25v-8.5a4.25 4.25 0 0 0-4.25-4.25h-8.5Zm8.88 2.12a1.12 1.12 0 1 1 0 2.25 1.12 1.12 0 0 1 0-2.25ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z"/></svg>
                </a>
                <a href="https://www.facebook.com/search/top?q=AccidentER%20Urgent%20Care%20MD" target="_blank" rel="noopener noreferrer" class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white transition-transform duration-300 hover:scale-110" aria-label="Facebook">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.87.25-1.46 1.5-1.46h1.6V4.94A21.4 21.4 0 0 0 14.2 4c-2.37 0-3.99 1.45-3.99 4.1V11H7.5v3h2.71v8h3.29Z"/></svg>
                </a>
                <a href="https://www.tiktok.com/search?q=AccidentER%20Urgent%20Care%20MD" target="_blank" rel="noopener noreferrer" class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-white transition-transform duration-300 hover:scale-110" aria-label="TikTok">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M14.76 3c.58 1.38 1.72 2.56 3.24 3.14v2.52a7.1 7.1 0 0 1-3.2-.86v5.28a5.94 5.94 0 1 1-5.1-5.88v2.6a3.36 3.36 0 1 0 2.52 3.24V3h2.54Z"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
