---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Section from "../../components/Section.astro";
import ContactForm from "../../components/ContactForm.astro";
import TestimonialsCarousel from "../../components/TestimonialsCarousel.astro";
import CTA from "../../components/CTA.astro";
import { t } from "../../i18n";
const locale = "en";
const seo = {
  title: "Privacy Policy | Accident ER – Urgent Care MD",
  description: "How Accident ER collects, uses, and protects personal information.",
  canonical: "https://accidenter-urgentcaremd.com/en/privacy-policy"
};
const breadcrumb = [
  { label: t(locale, "common.breadcrumb.home"), href: "/en" },
  { label: "Privacy Policy", href: "/en/privacy-policy" }
];
const closingCTA = t(locale, "home.closingCTA");
---
<BaseLayout locale={locale} title={seo.title} description={seo.description} canonical={seo.canonical}>
  <section class="relative overflow-hidden bg-black border-b border-brand-accent min-h-[420px] sm:min-h-[520px]">
    <video src="/videos/bilingual.mp4" class="absolute inset-0 block w-full h-full object-cover object-center" autoplay muted playsinline poster="/images/accident-medical.jpg"></video>
    <div class="absolute inset-0 bg-gradient-to-r from-black/75 via-black/60 to-transparent"></div>
    <div class="container relative z-10 py-16 sm:py-24 lg:py-28">
      <div class="max-w-4xl">
        <p class="text-white/80 text-sm uppercase tracking-[0.2em]">Legal</p>
        <h1 class="mt-3 text-4xl sm:text-5xl lg:text-6xl font-heading text-white">Privacy Policy</h1>
        <p class="mt-5 text-white/90 max-w-2xl">We protect your information and use it only to support your care journey, communication, and appointment coordination.</p>
      </div>
    </div>
  </section>
  <Breadcrumbs items={breadcrumb} />
  <Section title="How We Handle Your Data" align="center">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="rounded-xl border border-brand-accent bg-white p-5 shadow-sm text-left">
        <h3 class="text-lg font-heading text-brand-dark">Collected Information</h3>
        <p class="mt-2 text-brand-dark/90">Name, phone, email, and message details submitted through website forms.</p>
      </div>
      <div class="rounded-xl border border-brand-accent bg-white p-5 shadow-sm text-left">
        <h3 class="text-lg font-heading text-brand-dark">Purpose</h3>
        <p class="mt-2 text-brand-dark/90">Inquiry response, appointment scheduling, and patient communication follow-up.</p>
      </div>
      <div class="rounded-xl border border-brand-accent bg-white p-5 shadow-sm text-left">
        <h3 class="text-lg font-heading text-brand-dark">Control</h3>
        <p class="mt-2 text-brand-dark/90">You may request access, correction, or deletion of your submitted data.</p>
      </div>
    </div>
  </Section>
  <Section title="Privacy Policy Details" align="center">
    <div class="max-w-4xl mx-auto space-y-4 text-left">
      <div class="rounded-xl border border-brand-accent bg-white p-5 shadow-sm text-brand-dark">
        <p>We collect information you provide through our forms, including name, phone number, email, and message details, to support appointment coordination and patient communication.</p>
      </div>
      <div class="rounded-xl border border-brand-accent bg-white p-5 shadow-sm text-brand-dark">
        <p>We use submitted information to respond to inquiries, schedule visits, and share updates related to your request. We do not sell personal information.</p>
      </div>
      <div class="rounded-xl border border-brand-accent bg-white p-5 shadow-sm text-brand-dark">
        <p>We may use trusted service providers to process submitted form data and communications. These providers are required to protect your data appropriately.</p>
      </div>
      <div class="rounded-xl border border-brand-accent bg-white p-5 shadow-sm text-brand-dark">
        <p>By submitting your information, you consent to contact by phone, email, or SMS when applicable to your request. Message and data rates may apply.</p>
      </div>
      <div class="rounded-xl border border-brand-accent bg-white p-5 shadow-sm text-brand-dark">
        <p>If you need to request data access, correction, or deletion, contact us at <a class="underline hover:no-underline" href="mailto:orders@accidenter.com">orders@accidenter.com</a>.</p>
        <p class="mt-3 text-sm text-brand-dark/70">Last updated: March 11, 2026.</p>
      </div>
    </div>
  </Section>
  <section class="container py-8">
    <ContactForm locale={locale} />
  </section>
  <Section title="What our patients say about AccidentER®" align="center">
    <TestimonialsCarousel locale={locale} />
  </Section>
  <Section title={closingCTA.title} align="center">
    <div class="max-w-6xl mx-auto">
      <div class="rounded-2xl bg-brand-accent text-brand-dark p-6 flex flex-col md:flex-row md:items-center md:justify-center gap-4 text-center">
        <p class="text-white">{closingCTA.text}</p>
        <div class="flex gap-3 justify-center">
          <CTA text={closingCTA.CTA} href={"tel:+18019967427"} variant="primary" />
          <CTA text={"Schedule Now"} href={"mailto:orders@accidenter.com"} variant="success" />
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
