---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Section from "../../components/Section.astro";
import ContactPageForm from "../../components/ContactPageForm.astro";
import TestimonialsCarousel from "../../components/TestimonialsCarousel.astro";
import ContactFaqAccordion from "../../components/ContactFaqAccordion.astro";
import CTA from "../../components/CTA.astro";
import { t } from "../../i18n";
const locale = "es";
const contact = t(locale, "contact");
const seo = contact.seo;
const breadcrumb = contact.breadcrumb.items;
const hero = contact.hero;
const quickActions = contact.quickActions.items;
const form = contact.form;
const details = contact.details;
const faq = contact.faq;
const clinicMapEmbed = "https://www.google.com/maps?q=6770%20S%20900%20E%2C%20Midvale%2C%20UT%2084047&output=embed";
const clinicDirections = "https://www.google.com/maps/search/?api=1&query=6770%20S%20900%20E%2C%20Midvale%2C%20UT%2084047";
const extraFaq = [
  {
    question: "¿Necesito cita después de un accidente?",
    answer: "No. Aceptamos pacientes sin cita. También puedes llamar antes para agilizar tu ingreso."
  },
  {
    question: "¿Qué debo llevar a la consulta?",
    answer: "Trae identificación, información de seguro si la tienes, y reportes del accidente o estudios previos."
  },
  {
    question: "¿Me atienden si los síntomas aparecen después?",
    answer: "Sí. Muchos síntomas aparecen horas o días después y una evaluación temprana ayuda a recuperarte mejor."
  }
];
const contactFaqItems = [...(faq.items || []), ...extraFaq].slice(0, 6);
const leadSurvey = {
  title: "¿Necesitas ayuda después de un accidente?",
  description: "Abre el formulario guiado y comparte los detalles del accidente con nuestro equipo.",
  buttonLabel: "Abrir formulario de asistencia"
};
---
<BaseLayout locale={locale} title={seo.title} description={seo.description} canonical={seo.canonical}>
  <section class="relative overflow-hidden bg-black border-b border-brand-accent min-h-[460px] sm:min-h-[540px] lg:min-h-[620px]">
    <video id="hero-video" src="/videos/xray.mp4" class="absolute inset-0 block w-full h-full object-cover object-center transition-opacity duration-700" autoplay muted playsinline poster="/images/hero.jpg"></video>
    <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/50 to-transparent"></div>
    <div class="container relative z-10 py-16 sm:py-24 lg:py-28">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div class="">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading text-white drop-shadow-lg">{hero.title}</h1>
            <p class="mt-6 text-white drop-shadow">{hero.subtitle}</p>
            <p class="mt-2 text-sm text-white/80 drop-shadow">{hero.safetyNote}</p>
          </div>
          <div></div>
        </div>
      </div>
    </div>
    <button id="hero-sound" class="absolute bottom-4 right-4 z-10 bg-white/80 text-brand-dark px-3 py-1 rounded-full text-xs">Activar sonido</button>
    <script>
      const video = document.getElementById("hero-video");
      const btn = document.getElementById("hero-sound");
      if (video && btn) {
        btn.addEventListener("click", () => {
          const isMuted = video.hasAttribute("muted");
          if (isMuted) {
            video.removeAttribute("muted");
            btn.textContent = "Silenciar";
          } else {
            video.setAttribute("muted", "");
            btn.textContent = "Activar sonido";
          }
        });
      }
    </script>
  </section>
  <Breadcrumbs items={breadcrumb} />
  <Section title={""} align="center">
    <div class="max-w-6xl mx-auto rounded-3xl border border-brand-accent/40 bg-[#f7fbff] p-4 sm:p-6 lg:p-7">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        <article class="contact-quick-card-es" data-contact-quick-es>
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-dark text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.46 15.46 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.32.56 3.57.56a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.3 21 3 13.7 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.56 3.57a1 1 0 0 1-.24 1.02l-2.2 2.2Z"/></svg>
          </span>
          <h3 class="mt-3 text-xl font-heading text-brand-dark">{quickActions[0].title}</h3>
          <p class="mt-2 text-brand-dark/85">{quickActions[0].text}</p>
          <a href="tel:+18019967427" class="mt-4 button-primary w-fit">{quickActions[0].hrefLabel}</a>
        </article>
        <article class="contact-quick-card-es" data-contact-quick-es>
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-dark text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.19 7 13 7 13s7-7.81 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"/></svg>
          </span>
          <h3 class="mt-3 text-xl font-heading text-brand-dark">{quickActions[1].title}</h3>
          <p class="mt-2 text-brand-dark/85">{quickActions[1].text}</p>
          <a href="https://www.google.com/maps/search/?api=1&query=6770%20S%20900%20E%2C%20Midvale%2C%20UT%2084047" class="mt-4 button-success w-fit">{quickActions[1].hrefLabel}</a>
        </article>
        <article class="contact-quick-card-es" data-contact-quick-es>
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-dark text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M4 5h16a1 1 0 0 1 1 1v.73l-9 5.4-9-5.4V6a1 1 0 0 1 1-1Zm17 3.27V18a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8.27l8.49 5.1a1 1 0 0 0 1.02 0L21 8.27Z"/></svg>
          </span>
          <h3 class="mt-3 text-xl font-heading text-brand-dark">{quickActions[2].title}</h3>
          <p class="mt-2 text-brand-dark/85">{quickActions[2].text}</p>
          <a href="mailto:orders@accidenter.com" class="mt-4 button-outline-dark w-fit">Enviar correo</a>
        </article>
      </div>
    </div>
    <script>
      const quickCardsEs = Array.from(document.querySelectorAll("[data-contact-quick-es]"));
      const quickObserverEs = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry, idx) => {
          if (!entry.isIntersecting) return;
          setTimeout(() => entry.target.classList.add("is-visible"), idx * 110);
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.2 });
      quickCardsEs.forEach((card) => quickObserverEs.observe(card));
    </script>
    <style>
      .contact-quick-card-es {
        border: 1px solid rgba(10, 26, 47, 0.12);
        border-radius: 1rem;
        background: #ffffff;
        padding: 1rem;
        text-align: left;
        opacity: 0;
        transform: translateY(14px) scale(.99);
        transition: opacity .55s ease, transform .55s ease, box-shadow .3s ease;
      }
      .contact-quick-card-es.is-visible {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      .contact-quick-card-es:hover {
        box-shadow: 0 16px 30px -22px rgba(10, 26, 47, 0.72);
      }
      @media (prefers-reduced-motion: reduce) {
        .contact-quick-card-es {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
  </Section>
  <Section title={leadSurvey.title} align="center">
    <div class="max-w-5xl mx-auto rounded-3xl border border-brand-accent/40 bg-[#f7fbff] p-4 sm:p-6 lg:p-7">
      <div class="assist-card-es" data-assist-card-es>
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-5 items-center">
          <div class="lg:col-span-3 text-left">
            <span class="inline-flex w-fit items-center rounded-full border border-brand-primary/30 bg-brand-primary/10 px-3 py-1 text-[11px] uppercase tracking-[0.16em] text-brand-primary">Ingreso guiado</span>
            <h3 class="mt-3 text-2xl sm:text-3xl font-heading text-brand-dark">{leadSurvey.title}</h3>
            <p class="mt-3 text-brand-dark/85">{leadSurvey.description}</p>
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-2">
              <span class="inline-flex items-center gap-2 rounded-xl border border-brand-accent/40 bg-white px-3 py-2 text-sm text-brand-dark"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M4 5h16a1 1 0 0 1 1 1v.73l-9 5.4-9-5.4V6a1 1 0 0 1 1-1Zm17 3.27V18a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8.27l8.49 5.1a1 1 0 0 0 1.02 0L21 8.27Z"/></svg>Flujo seguro</span>
              <span class="inline-flex items-center gap-2 rounded-xl border border-brand-accent/40 bg-white px-3 py-2 text-sm text-brand-dark"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-primary" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 1 0 20 10 10 0 0 1 0-20Zm.75 5a.75.75 0 0 0-1.5 0v5.25c0 .27.15.52.39.65l3.25 1.88a.75.75 0 1 0 .75-1.3l-2.89-1.67V7Z"/></svg>Respuesta rápida</span>
            </div>
          </div>
          <div class="lg:col-span-2 rounded-2xl border border-brand-accent/40 bg-white p-4 sm:p-5 text-center">
            <p class="text-sm text-brand-dark/80">Inicia tu solicitud de asistencia en pocos minutos.</p>
            <button type="button" id="open-assistance-modal-es" class="mt-4 button-success inline-flex items-center justify-center w-full">
              {leadSurvey.buttonLabel}
            </button>
          </div>
        </div>
      </div>
      <div id="assistance-modal-es" class="fixed inset-0 z-[120] hidden" aria-hidden="true">
        <div id="assistance-modal-overlay-es" class="absolute inset-0 bg-black/70"></div>
        <div class="relative z-[121] min-h-screen flex items-center justify-center p-4">
          <div class="w-full max-w-5xl rounded-2xl bg-white border border-brand-accent shadow-xl overflow-hidden">
            <div class="flex items-center justify-between px-4 py-3 border-b border-brand-accent">
              <h3 class="font-heading text-brand-dark">{leadSurvey.buttonLabel}</h3>
              <button type="button" id="close-assistance-modal-es" class="button-outline-dark">×</button>
            </div>
            <div class="p-0">
              <iframe
                src="https://api.leadconnectorhq.com/widget/survey/VPSfhjdEmD58v7jc5ocl"
                style="border:none;width:100%;"
                scrolling="no"
                id="VPSfhjdEmD58v7jc5ocl"
                title="survey"
                class="w-full min-h-[620px]"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script>
      const assistCardEs = document.querySelector("[data-assist-card-es]");
      const assistObserverEs = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.2 });
      if (assistCardEs) assistObserverEs.observe(assistCardEs);
    </script>
    <style>
      .assist-card-es {
        border: 1px solid rgba(10, 26, 47, 0.12);
        border-radius: 1rem;
        background: #ffffff;
        padding: 1rem;
        opacity: 0;
        transform: translateY(14px) scale(.99);
        transition: opacity .55s ease, transform .55s ease, box-shadow .3s ease;
      }
      .assist-card-es.is-visible {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      .assist-card-es:hover {
        box-shadow: 0 18px 30px -24px rgba(10, 26, 47, 0.75);
      }
      @media (prefers-reduced-motion: reduce) {
        .assist-card-es {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>
    <script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
    <script>
      const assistanceModalEs = document.getElementById("assistance-modal-es");
      const openAssistanceModalEs = document.getElementById("open-assistance-modal-es");
      const closeAssistanceModalEs = document.getElementById("close-assistance-modal-es");
      const assistanceModalOverlayEs = document.getElementById("assistance-modal-overlay-es");
      function showAssistanceModalEs() {
        if (!assistanceModalEs) return;
        assistanceModalEs.classList.remove("hidden");
        assistanceModalEs.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }
      function hideAssistanceModalEs() {
        if (!assistanceModalEs) return;
        assistanceModalEs.classList.add("hidden");
        assistanceModalEs.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }
      openAssistanceModalEs?.addEventListener("click", showAssistanceModalEs);
      closeAssistanceModalEs?.addEventListener("click", hideAssistanceModalEs);
      assistanceModalOverlayEs?.addEventListener("click", hideAssistanceModalEs);
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") hideAssistanceModalEs();
      });
    </script>
  </Section>
  <Section title={form.title} align="center">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="rounded-2xl bg-white p-6 border border-brand-accent">
        <h3 class="text-xl font-heading text-brand-dark mb-4">{form.title}</h3>
        <ContactPageForm locale={locale} form={form} actionUrl={"ACTION_URL_PLACEHOLDER"} />
      </div>
      <div class="rounded-2xl bg-white p-6 border border-brand-accent">
        <h3 class="text-xl font-heading text-brand-dark">{details.title}</h3>
        <div class="mt-4 space-y-4">
          <div>
            <p class="text-sm font-heading text-brand-dark">{details.phoneLabel}</p>
            <a class="text-brand-dark hover:text-brand-primary underline-offset-2 hover:underline" href="tel:+18019967427">+1 801-996-7427</a>
          </div>
          <div class="h-px bg-brand-accent/40"></div>
          <div>
            <p class="text-sm font-heading text-brand-dark">{details.addressLabel}</p>
            <a class="text-brand-dark hover:text-brand-primary underline-offset-2 hover:underline" href="https://www.google.com/maps/search/?api=1&query=6770%20S%20900%20E%2C%20Midvale%2C%20UT%2084047">6770 S 900 E, Midvale, UT 84047, EE. UU.</a>
          </div>
          <div class="h-px bg-brand-accent/40"></div>
          <div>
            <p class="text-sm font-heading text-brand-dark">{details.hoursLabel}</p>
            <ul class="text-brand-dark">
              {(details.hoursLines || []).map((h: string) => (
                <li class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-success" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 5h-2v6h6v-2h-4V7z"/></svg>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="h-px bg-brand-accent/40"></div>
          <p class="text-sm text-brand-dark/80">{details.bilingualNote}</p>
          <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
            <a id="schedule-email-link-es" class="button-secondary w-full inline-flex items-center justify-center gap-2" href="#">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16a2 2 0 012 2v1l-10 6L2 7V6a2 2 0 012-2zm0 6.35l8 4.8 8-4.8V18a2 2 0 01-2 2H6a2 2 0 01-2-2v-7.65z"/></svg>
              <span>Agendar por correo</span>
            </a>
            <a id="google-calendar-link-es" class="button-outline-dark w-full inline-flex items-center justify-center gap-2" href="#" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M7 2v2H5a2 2 0 00-2 2v1h18V6a2 2 0 00-2-2h-2V2h-2v2H9V2H7zm16 7H1v11a2 2 0 002 2h18a2 2 0 002-2V9zm-5 6h-6v-2h4v-3h2v5z"/></svg>
              <span>Agregar a Calendario</span>
            </a>
          </div>
          <script>
            const emailLinkEs = document.getElementById("schedule-email-link-es") as HTMLAnchorElement | null;
            const calLinkEs = document.getElementById("google-calendar-link-es") as HTMLAnchorElement | null;
            function pad(n) { return n.toString().padStart(2, "0"); }
            function nextSlot() {
              const d = new Date();
              d.setDate(d.getDate() + 1);
              const day = d.getDay();
              if (day === 0) d.setDate(d.getDate() + 1);
              d.setHours(10, 0, 0, 0);
              return d;
            }
            const slot = nextSlot();
            const yyyy = slot.getFullYear();
            const mm = pad(slot.getMonth() + 1);
            const dd = pad(slot.getDate());
            const HH = pad(slot.getHours());
            const human = `${yyyy}-${mm}-${dd} ${HH}:00`;
            const address = "6770 S 900 E, Midvale, UT 84047, EE. UU.";
            const subject = encodeURIComponent(`Solicitud de cita — ${human}`);
            const body = encodeURIComponent(`Hola AccidentER,\n\nMe gustaría agendar una visita alrededor de ${human}.\n\nTeléfono: \nMotivo: \n\nDirección: ${address}\n\nGracias.`);
            const mailto = `mailto:orders@accidenter.com?subject=${subject}&body=${body}`;
            const gDate = `${yyyy}${mm}${dd}T${HH}0000Z`;
            const gEnd = `${yyyy}${mm}${dd}T${pad(slot.getHours() + 1)}0000Z`;
            const gText = encodeURIComponent("Visita AccidentER®");
            const gDetails = encodeURIComponent("Visita AccidentER® — Urgent Care MD");
            const gLocation = encodeURIComponent(address);
            const gUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${gText}&dates=${gDate}/${gEnd}&details=${gDetails}&location=${gLocation}`;
            emailLinkEs?.setAttribute("href", mailto);
            calLinkEs?.setAttribute("href", gUrl);
          </script>
        </div>
      </div>
    </div>
  </Section>
  <Section title={"Lo que dicen nuestros pacientes"} align="center">
    <TestimonialsCarousel locale={locale} />
  </Section>
  <Section title={"Preguntas frecuentes antes de tu visita"} align="center">
    <ContactFaqAccordion items={contactFaqItems} locale={locale} />
  </Section>
  <section class="container py-8 sm:py-12">
    <div class="max-w-6xl mx-auto">
      <div class="rounded-3xl border border-brand-accent/40 bg-[#f4f8ff] p-4 sm:p-6 lg:p-8 shadow-[0_18px_45px_-30px_rgba(10,26,47,0.45)]">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 sm:gap-6 items-stretch">
          <div class="lg:col-span-3 overflow-hidden rounded-2xl border border-brand-accent/30 min-h-[280px]">
            <iframe src={clinicMapEmbed} class="h-full w-full min-h-[280px]" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mapa de la clínica AccidentER"></iframe>
          </div>
          <div class="lg:col-span-2 rounded-2xl border border-brand-dark/10 bg-brand-dark p-4 sm:p-5 text-white flex flex-col justify-start">
            <span class="inline-flex w-fit items-center rounded-full border border-brand-success/35 bg-brand-success/15 px-3 py-1 text-[11px] uppercase tracking-[0.16em] text-brand-success">Atención sin cita</span>
            <p class="mt-3 text-sm sm:text-base text-white/90">Atención rápida enfocada en accidentes con apoyo bilingüe y diagnóstico en sitio.</p>
            <ul class="mt-3.5 space-y-2 text-sm text-white/80">
              <li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-brand-success/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.19 7 13 7 13s7-7.81 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z"/></svg><span>6770 S 900 E, Midvale, UT 84047</span></li>
              <li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-brand-success/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.75a.75.75 0 0 1 .75.75v8.25h4.75a.75.75 0 0 1 0 1.5H12a.75.75 0 0 1-.75-.75V2.5a.75.75 0 0 1 .75-.75ZM12 4a8 8 0 1 0 8 8 .75.75 0 0 1 1.5 0 9.5 9.5 0 1 1-9.5-9.5.75.75 0 0 1 0 1.5Z"/></svg><span>Lun–Vie · 9:00 AM–7:00 PM</span></li>
              <li class="flex items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-brand-success/90" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.75a.75.75 0 0 1 .75.75v8.25h4.75a.75.75 0 0 1 0 1.5H12a.75.75 0 0 1-.75-.75V2.5a.75.75 0 0 1 .75-.75ZM12 4a8 8 0 1 0 8 8 .75.75 0 0 1 1.5 0 9.5 9.5 0 1 1-9.5-9.5.75.75 0 0 1 0 1.5Z"/></svg><span>Sáb · 9:00 AM–3:00 PM</span></li>
            </ul>
            <div class="mt-4 flex flex-col items-center gap-2.5">
              <div class="w-fit scale-90 sm:scale-95 origin-center"><CTA text={"Llamar ahora"} href={"tel:+18019967427"} variant="primary" /></div>
              <div class="w-fit scale-90 sm:scale-95 origin-center"><CTA text={"Abrir en Maps"} href={clinicDirections} variant="success" /></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
